VEYRA_ENVIRONMENT=production
# Set a randomly generated secret in your secret manager, never in browser code.
VEYRA_GATEWAY_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VEYRA_ALLOWED_HOSTS=["veyra.example.com","127.0.0.1"]
VEYRA_CORS_ORIGINS=[]
VEYRA_ENABLE_ADMIN_JOBS=false
VEYRA_MAX_CONCURRENT_REQUESTS=4
VEYRA_DATABASE_PATH=/data/veyra.db
VEYRA_OLLAMA_URL=http://ollama:11434
VEYRA_OLLAMA_MODEL=qwen2.5-coder:1.5b
